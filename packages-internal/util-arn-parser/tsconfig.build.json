{
  "extends": "../../tsconfig.es.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist-es",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist-types",
    "tsBuildInfoFile": "../../.tsbuildinfo/packages-internal--util-arn-parser.tsbuildinfo",
    "paths": {
      "@aws-sdk/core/*": ["../core/dist-types/submodules/*/index.d.ts"]
    }
  },
  "include": ["src/"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    }
  ]
}
