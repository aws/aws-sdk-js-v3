{
  "extends": "../../tsconfig.es.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist-es",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist-types",
    "tsBuildInfoFile": "../../.tsbuildinfo/packages-internal--region-config-resolver.tsbuildinfo",
    "paths": {
      "@aws-sdk/core/*": ["../core/dist-types/submodules/*/index.d.ts"]
