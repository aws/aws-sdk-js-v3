{
  "extends": "../../tsconfig.es.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist-es",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist-types",
    "tsBuildInfoFile": "../../.tsbuildinfo/packages-internal--middleware-sdk-s3.tsbuildinfo",
    "paths": {
      "@aws-sdk/middleware-sdk-s3/s3": ["./src/submodules/s3/index.ts"],
      "@aws-sdk/middleware-sdk-s3/s3-control": ["./src/submodules/s3-control/index.ts"],
      "@smithy/core/*": ["../../node_modules/@smithy/core/dist-types/submodules/*/index.d.ts"]
    },
    "lib": []
  },
  "include": ["src/"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    },
    {
      "path": "../signature-v4-multi-region/tsconfig.build.json"
    },
    {
      "path": "../types/tsconfig.build.json"
    }
  ]
}
