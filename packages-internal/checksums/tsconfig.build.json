{
  "extends": "../../tsconfig.es.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist-es",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist-types",
    "tsBuildInfoFile": "../../.tsbuildinfo/packages-internal--checksums.tsbuildinfo",
    "paths": {
      "@aws-sdk/checksums/crc": ["./src/submodules/crc/index.ts"],
      "@aws-sdk/checksums/flexible-checksums": ["./src/submodules/flexible-checksums/index.ts"],
      "@aws-sdk/checksums/sha": ["./src/submodules/sha/index.ts"],
      "@aws-sdk/checksums/md5": ["./src/submodules/md5/index.ts"],
      "@smithy/core/*": ["../../node_modules/@smithy/core/dist-types/submodules/*/index.d.ts"]
    },
    "lib": []
  },
  "include": ["src/"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.fixture.ts"],
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    },
    {
      "path": "../types/tsconfig.build.json"
    }
  ]
}
