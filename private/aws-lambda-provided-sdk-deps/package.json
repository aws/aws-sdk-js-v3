{
  "name": "@aws-sdk/aws-lambda-provided-sdk-deps",
  "version": "3.1138.0",
  "private": true,
  "description": "Declares the registry packages the Lambda-provided-SDK payload needs but the SDK itself does not use. The payload must carry 47 deprecated @aws-sdk/* compatibility packages; most are forwarders that re-export a modern package, and nothing in the modern SDK depends on those re-export targets, so the assembler's dependency walk cannot reach them and yarn install would never fetch them. Declaring them here makes yarn put them in the root node_modules with their own transitive dependencies, which is where scripts/generate-lambda-provided-sdk/index.mjs copies them from. Ships no code.",
  "license": "Apache-2.0",
  "author": {
    "name": "AWS SDK for JavaScript Team",
    "url": "https://aws.amazon.com/sdk-for-javascript/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aws/aws-sdk-js-v3.git",
    "directory": "private/aws-lambda-provided-sdk-deps"
  },
  "sideEffects": false,
  "scripts": {
    "build": "exit 0",
    "build:cjs": "exit 0",
    "build:es": "exit 0",
    "build:include:deps": "yarn g:turbo run build -F=\"$npm_package_name\"",
    "build:types": "exit 0",
    "build:types:downlevel": "exit 0",
    "clean": "exit 0"
  },
  "dependencies": {
    "tslib": "^2.6.2"
  },
  "devDependencies": {
