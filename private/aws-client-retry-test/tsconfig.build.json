{
  "extends": "./tsconfig",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist-es",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist-types",
    "tsBuildInfoFile": "../../.tsbuildinfo/private--aws-client-retry-test.tsbuildinfo",
    "lib": [
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "removeComments": false,
    "strict": true,
    "isolatedModules": true
  },
  "include": [
    "src/"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../clients/client-lambda/tsconfig.build.json"
    }
  ]
}
