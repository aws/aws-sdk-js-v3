{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "importHelpers": true,
    "removeComments": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "useUnknownInCatchVariables": false
  },
  "include": ["src"],
  "exclude": ["**/*.spec.ts"]
}
