{
  "extends": "./tsconfig",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist-es",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist-types",
    "tsBuildInfoFile": "../../.tsbuildinfo/private--aws-protocoltests-restjson-glacier.tsbuildinfo",
    "lib": [
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "removeComments": false,
    "strict": true,
    "isolatedModules": true
  },
  "include": [
    "src/"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../packages-internal/body-checksum-browser/tsconfig.build.json"
    },
    {
      "path": "../../packages-internal/body-checksum-node/tsconfig.build.json"
    },
    {
      "path": "../../packages-internal/core/tsconfig.build.json"
    },
    {
      "path": "../../packages-internal/credential-provider-node/tsconfig.build.json"
    },
    {
      "path": "../../packages-internal/middleware-sdk-glacier/tsconfig.build.json"
    },
    {
      "path": "../../packages-internal/types/tsconfig.build.json"
    }
  ]
}
