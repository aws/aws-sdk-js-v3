{
  "extends": "../../tsconfig.es.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist-es",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist-types",
    "tsBuildInfoFile": "../../.tsbuildinfo/lib--lib-transfer-manager.tsbuildinfo",
    "paths": {
      "@aws-sdk/lib-transfer-manager/worker": ["./src/submodules/worker/index.ts"],
      "@aws-sdk/lib-transfer-manager/transfer-manager": ["./src/submodules/transfer-manager/index.ts"],
      "@smithy/core/*": ["../../node_modules/@smithy/core/dist-types/submodules/*/index.d.ts"],
      "@aws-sdk/config/*": ["../../packages/config/dist-types/submodules/*/index.d.ts"]
    },
    "lib": ["dom"]
  },
  "include": ["src/"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [
    {
      "path": "../../clients/client-s3/tsconfig.build.json"
    }
  ]
}
