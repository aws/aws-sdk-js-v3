{
  "extends": "../../tsconfig.es.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist-es",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist-types",
    "tsBuildInfoFile": "../../.tsbuildinfo/packages--s3-presigned-post.tsbuildinfo",
    "paths": {
      "@smithy/core/*": ["../../node_modules/@smithy/core/dist-types/submodules/*/index.d.ts"]
    },
    "lib": ["dom"]
  },
  "include": ["src/"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [
    {
      "path": "../../clients/client-s3/tsconfig.build.json"
    },
    {
      "path": "../../packages-internal/core/tsconfig.build.json"
    },
    {
      "path": "../../packages-internal/types/tsconfig.build.json"
    }
  ]
}
