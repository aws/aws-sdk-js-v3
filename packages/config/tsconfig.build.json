{
  "extends": "../../tsconfig.es.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist-es",
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "dist-types",
    "tsBuildInfoFile": "../../.tsbuildinfo/packages--config.tsbuildinfo",
    "paths": {
      "@aws-sdk/config/credentials": ["./src/submodules/credentials/index.ts"],
      "@aws-sdk/config/protocol": ["./src/submodules/protocol/index.ts"],
      "@aws-sdk/config/requestHandler": ["./src/submodules/requestHandler/index.ts"],
      "@aws-sdk/config/retryStrategy": ["./src/submodules/retryStrategy/index.ts"],
      "@aws-sdk/config/typecheck": ["./src/submodules/typecheck/index.ts"],
      "@aws-sdk/config/logger": ["./src/submodules/logger/index.ts"],
      "@smithy/core/*": ["../../node_modules/@smithy/core/dist-types/submodules/*/index.d.ts"]
    }
  },
  "include": ["src/"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [
    {
      "path": "../../packages-internal/core/tsconfig.build.json"
    },
    {
      "path": "../credential-providers/tsconfig.build.json"
    },
    {
      "path": "../../packages-internal/types/tsconfig.build.json"
    }
  ]
}
